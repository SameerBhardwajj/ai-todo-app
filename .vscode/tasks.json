{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install Expo Android settings launcher",
			"type": "shell",
			"command": "npx",
			"args": [
				"expo",
				"install",
				"expo-intent-launcher"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Typecheck enrolled credential support",
			"type": "shell",
			"command": "npm",
			"args": [
				"exec",
				"--",
				"tsc",
				"--noEmit"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Typecheck PIN and biometric settings",
			"type": "shell",
			"command": "npm",
			"args": [
				"exec",
				"--",
				"tsc",
				"--noEmit"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Final Expo SDK check",
			"type": "shell",
			"command": "npx",
			"args": [
				"expo",
				"install",
				"--check"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Final Android biometric export",
			"type": "shell",
			"command": "npx",
			"args": [
				"expo",
				"export",
				"--platform",
				"android",
				"--output-dir",
				"C:\\Users\\hd\\AppData\\Local\\Temp\\todo-app-biometric-final-export"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run Expo Android app",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"android"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run Expo Android app (8082)",
			"type": "shell",
			"command": "npx",
			"args": [
				"expo",
				"start",
				"--android",
				"--port",
				"8082"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start Expo for Android device (8082)",
			"type": "shell",
			"command": "npx",
			"args": [
				"expo",
				"start",
				"--port",
				"8082"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start Expo for Android device",
			"type": "shell",
			"command": "npm",
			"args": [
				"start"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start Expo Android tunnel",
			"type": "shell",
			"command": "npx",
			"args": [
				"expo",
				"start",
				"--tunnel",
				"--port",
				"8082"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start Expo Android tunnel (8081)",
			"type": "shell",
			"command": "npx",
			"args": [
				"expo",
				"start",
